{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:fish-memory:review-episode:v1",
	"title": "ReviewEpisode",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"operation_id",
		"base_seq",
		"title",
		"summary",
		"source_ids",
		"beats",
		"interpretations",
		"thread",
		"activity_state",
		"unknowns"
	],
	"properties": {
		"person_review": {
			"type": "object",
			"additionalProperties": false,
			"description": "Associate the saved episode revision with a person in the same transaction. Create with name and identity or update with id and expected_revision. Include a complete impression only when understanding changes.",
			"properties": {
				"name": { "type": "string", "pattern": "\\S", "maxLength": 128 },
				"identity": { "type": "string", "pattern": "\\S", "maxLength": 512 },
				"id": { "type": "string", "minLength": 1, "maxLength": 128 },
				"expected_revision": { "type": "integer", "minimum": 1 },
				"impression": { "type": "string", "pattern": "\\S", "maxLength": 2048 },
				"other_episodes": {
					"type": "array",
					"maxItems": 31,
					"uniqueItems": true,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "revision"],
						"properties": {
							"id": { "type": "string", "minLength": 1, "maxLength": 128 },
							"revision": { "type": "integer", "minimum": 1 }
						}
					}
				}
			}
		},
		"operation_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,128}$"
		},
		"base_seq": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"id": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"expected_revision": {
			"type": "integer",
			"minimum": 1
		},
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"summary": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4096
		},
		"source_ids": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 128
			}
		},
		"beats": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["text", "source_ids"],
				"properties": {
					"text": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2048
					},
					"source_ids": {
						"type": "array",
						"minItems": 1,
						"maxItems": 32,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					}
				}
			}
		},
		"interpretations": {
			"type": "array",
			"maxItems": 16,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["text", "kind", "source_ids"],
				"properties": {
					"text": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2048
					},
					"kind": {
						"enum": ["expressed", "retrospective", "inferred"]
					},
					"source_ids": {
						"type": "array",
						"minItems": 1,
						"maxItems": 32,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					}
				}
			}
		},
		"thread": {
			"type": ["string", "null"],
			"maxLength": 256
		},
		"activity_state": {
			"enum": ["active", "paused", "completed", "abandoned", "unknown"]
		},
		"unknowns": {
			"type": "array",
			"maxItems": 16,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 1024
			}
		}
	}
}
