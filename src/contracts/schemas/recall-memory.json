{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:fish-memory:recall-memory:v1",
	"title": "RecallMemory",
	"type": "object",
	"additionalProperties": false,
	"required": ["query"],
	"properties": {
		"query": {
			"type": "string",
			"maxLength": 512
		},
		"limit": {
			"type": "integer",
			"minimum": 1,
			"maximum": 20
		},
		"max_bytes": {
			"type": "integer",
			"minimum": 1024,
			"maximum": 65536
		}
	}
}
