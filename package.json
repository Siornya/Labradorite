{
	"name": "fish-memory-service",
	"version": "0.0.0",
	"private": true,
	"description": "A long-term life memory service for virtual characters.",
	"type": "module",
	"scripts": {
		"contracts:generate": "node scripts/generate-contracts.mjs",
		"contracts:check": "node scripts/generate-contracts.mjs --check",
		"format": "vp fmt --write .",
		"lint": "vp lint src tests scripts && vp fmt --check .",
		"typecheck": "tsc --noEmit",
		"build": "vp pack",
		"test": "vp run build && vp test",
		"check": "vp run contracts:check && vp check && vp run test",
		"start": "node dist/src/mcp-main.js",
		"mcp": "node dist/src/mcp-main.js",
		"setup": "node dist/src/setup.js",
		"prepare": "vp config"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.2",
		"ajv": "8.20.0",
		"better-sqlite3": "13.0.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.2",
		"json-schema-to-typescript": "16.0.0",
		"typescript": "7.0.2",
		"vite-plus": "1.4.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
	},
	"devEngines": {
		"packageManager": [
			{
				"name": "pnpm",
				"version": "12.16.1",
				"onFail": "download"
			}
		]
	},
	"engines": {
		"node": ">=24"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	}
}
