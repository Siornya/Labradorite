{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:fish-memory:delete-memory:v2",
	"title": "DeleteMemory",
	"type": "object",
	"additionalProperties": false,
	"required": ["operation_id", "source_ids", "preview_token"],
	"properties": {
		"operation_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,128}$"
		},
		"source_ids": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 128
			}
		},
		"preview_token": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		}
	}
}
