{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "ReviewPerson",
	"type": "object",
	"additionalProperties": false,
	"required": ["operation_id", "base_seq", "episodes"],
	"properties": {
		"operation_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
		"base_seq": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
		"id": { "type": "string", "minLength": 1, "maxLength": 128 },
		"expected_revision": { "type": "integer", "minimum": 1 },
		"name": { "type": "string", "pattern": "\\S", "maxLength": 128 },
		"identity": { "type": "string", "pattern": "\\S", "maxLength": 512 },
		"impression": { "type": "string", "pattern": "\\S", "maxLength": 2048 },
		"episodes": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "revision"],
				"properties": {
					"id": { "type": "string", "minLength": 1, "maxLength": 128 },
					"revision": { "type": "integer", "minimum": 1 }
				}
			}
		}
	}
}
