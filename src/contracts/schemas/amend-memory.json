{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:fish-memory:amend-memory:v1",
	"title": "AmendMemory",
	"type": "object",
	"additionalProperties": false,
	"required": ["operation_id", "base_seq", "id", "expected_revision"],
	"properties": {
		"operation_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,128}$"
		},
		"base_seq": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"id": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"expected_revision": {
			"type": "integer",
			"minimum": 1
		},
		"append_source_ids": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 128
			}
		},
		"append_beats": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["text", "source_ids"],
				"properties": {
					"text": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2048
					},
					"source_ids": {
						"type": "array",
						"minItems": 1,
						"maxItems": 32,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					}
				}
			}
		},
		"append_interpretations": {
			"type": "array",
			"maxItems": 16,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["text", "kind", "source_ids"],
				"properties": {
					"text": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2048
					},
					"kind": {
						"enum": ["expressed", "retrospective", "inferred"]
					},
					"source_ids": {
						"type": "array",
						"minItems": 1,
						"maxItems": 32,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					}
				}
			}
		},
		"append_unknowns": {
			"type": "array",
			"maxItems": 16,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 1024
			}
		},
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"summary": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4096
		},
		"thread": {
			"type": ["string", "null"],
			"maxLength": 256
		},
		"activity_state": {
			"enum": ["active", "paused", "completed", "abandoned", "unknown"]
		},
		"dry_run": {
			"type": "boolean"
		}
	}
}
