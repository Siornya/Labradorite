{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "ReviewSetting",
	"type": "object",
	"additionalProperties": false,
	"required": ["operation_id", "base_seq", "setting", "reason", "episodes"],
	"properties": {
		"operation_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,128}$"
		},
		"base_seq": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"episodes": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "revision"],
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"revision": {
						"type": "integer",
						"minimum": 1
					}
				}
			}
		},
		"reason": {
			"type": "string",
			"pattern": "\\S",
			"maxLength": 2048
		},
		"setting": {
			"type": "object",
			"additionalProperties": false,
			"required": ["target", "title", "body"],
			"properties": {
				"target": {
					"enum": ["character", "world"]
				},
				"title": {
					"type": "string",
					"pattern": "\\S",
					"maxLength": 128
				},
				"body": {
					"type": "string",
					"pattern": "\\S",
					"maxLength": 4096
				},
				"id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"expected_version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				}
			}
		}
	}
}
